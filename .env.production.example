# Modelo das variáveis a cadastrar no Coolify (NÃO coloque valores reais neste arquivo).
# Gere segredos com:  openssl rand -base64 48  (SECRET_KEY)  e  openssl rand -hex 32  (API_TOKEN_PEPPER_1)

ALLOWED_HOSTS=netbox.suaempresa.com.br
CSRF_TRUSTED_ORIGINS=https://netbox.suaempresa.com.br
TIME_ZONE=America/Fortaleza

SECRET_KEY=
API_TOKEN_PEPPER_1=

# URL interna do PostgreSQL no Coolify — troque usuário/senha/banco para os do NetBox (não use o postgres)
DATABASE_URL=postgres://netbox:SENHA@HOST_INTERNO:5432/netbox

# URL interna do Redis no Coolify. O número no fim é o banco das filas; o cache usa REDIS_CACHE_DATABASE.
# Se o Redis for compartilhado com outras aplicações, escolha números livres.
REDIS_URL=redis://default:SENHA@HOST_INTERNO:6379/0
REDIS_CACHE_DATABASE=1

# Desempenho (VPS 16 vCPU / 16 GB)
GRANIAN_WORKERS=8
GRANIAN_BLOCKING_THREADS=2

EMAIL_SERVER=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true

# Com restore do backup antigo, os usuários já existem: mantenha true
SKIP_SUPERUSER=true
