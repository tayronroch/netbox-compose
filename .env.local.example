# Ambiente local — copie para .env.local (que é ignorado pelo git)
ALLOWED_HOSTS=localhost 127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
DEBUG=false

SECRET_KEY=troque-por-uma-chave-de-50-caracteres-ou-mais-xxxxxxxxxxxxx
API_TOKEN_PEPPER_1=troque-por-outra-chave-de-50-caracteres-ou-mais-xxxxxxxxx

DATABASE_URL=postgres://netbox:netbox-local@postgres:5432/netbox

REDIS_URL=redis://:redis-local@redis:6379/0

# Menos workers na máquina de desenvolvimento
GRANIAN_WORKERS=2

SKIP_SUPERUSER=false
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@localhost
SUPERUSER_PASSWORD=admin
